{
  "$schema": "node_modules/wrangler/config-schema.json",

  // NOTE: on this branch the default Worker name is deliberately DIFFERENT
  // from the one on main.
  //
  // WHAT THIS DOES PROTECT: an accidental `npx wrangler deploy` run by hand
  // from this branch. It targets lsa-calendar, not the live website.
  //
  // WHAT IT DOES NOT PROTECT: Cloudflare Workers Builds. A build project is
  // bound to its own Worker and deploys there regardless of the name in this
  // file — twice, the website project built this branch and served it as the
  // live site, putting a password in front of the public website. The only
  // thing that prevents that is turning OFF "Builds for non-production
  // branches" on the website project (Settings -> Builds -> Branch control).
  // That is now off; do not turn it back on while this branch exists.
  //
  // The cost of the rename is one conflicting line when this branch is merged
  // into main: keep main's name, "lsa-website".
  "name": "lsa-calendar",

  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // Kept so that `npx wrangler deploy --env calendar` also works and targets the
  // same Worker, whichever form the Cloudflare project is configured with.
  "env": {
    "calendar": {
      "name": "lsa-calendar",
      "observability": {
        "enabled": true
      }
    }
  }
}
