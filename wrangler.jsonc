{
  "$schema": "node_modules/wrangler/config-schema.json",

  // NOTE: on this branch the default Worker name is deliberately DIFFERENT from
  // the one on main.
  //
  // Cloudflare Workers Builds runs a project's deploy command for whatever
  // branch it is told to build. The website project's command is a plain
  // `npx wrangler deploy`, which takes the name from this file — so when this
  // branch was built by that project, it deployed the calendar over the live
  // website and put a password in front of the public site.
  //
  // Naming the default environment "lsa-calendar" here makes that impossible:
  // whichever command runs, and whichever project runs it, this branch can only
  // ever deploy to the calendar Worker. Disabling non-production branch builds
  // on the website project is still worth doing, but this is the safeguard that
  // does not depend on a dashboard setting staying correct.
  //
  // The cost is one conflicting line when this branch is eventually merged into
  // main: keep main's name, "lsa-website".
  "name": "lsa-calendar",

  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // Kept so that `npx wrangler deploy --env calendar` also works and targets the
  // same Worker, whichever form the Cloudflare project is configured with.
  "env": {
    "calendar": {
      "name": "lsa-calendar",
      "observability": {
        "enabled": true
      }
    }
  }
}
