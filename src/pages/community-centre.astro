---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ContentPage from '../components/ContentPage.astro';
import Gallery from '../components/Gallery.astro';
import AvailabilityCalendar from '../components/AvailabilityCalendar.astro';
import HireForm from '../components/HireForm.astro';

const entry = await getEntry('centre', 'centre');
if (!entry) throw new Error('Missing page content: src/content/centre/centre.md');
const centre = entry.data;
---

<Base
  title="Community Centre"
  description="A welcoming venue in Townsville for meetings, classes and celebrations — check availability and apply to hire online."
>
  <ContentPage page={centre} />

  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6" aria-labelledby="gallery-heading">
    <div class="h-1 w-10 rounded bg-gold-500" aria-hidden="true"></div>
    <h2 id="gallery-heading" class="font-display mt-4 text-2xl font-semibold text-teal-900 sm:text-3xl">
      Inside the Centre
    </h2>
    <div class="mt-6">
      <Gallery />
    </div>
  </section>

  <section class="bg-teal-50/60" aria-labelledby="hire-heading">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <div class="h-1 w-10 rounded bg-gold-500" aria-hidden="true"></div>
      <h2 id="hire-heading" class="font-display mt-4 text-2xl font-semibold text-teal-900 sm:text-3xl">
        {centre.hireHeading}
      </h2>
      {centre.hireCalendarNote && <p class="mt-3 max-w-2xl text-ink/70">{centre.hireCalendarNote}</p>}
      <p class="mt-3">
        <a
          href="/files/centre-use-policy.pdf"
          class="inline-flex items-center gap-2 text-sm font-medium text-teal-700 underline decoration-gold-500/60 underline-offset-2 hover:text-teal-900"
        >
          <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m6.75 12-3 3m0 0-3-3m3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"></path>
          </svg>
          Read the Centre Use Policy before applying (PDF)
        </a>
      </p>
      <div class="mt-8 grid gap-8 lg:grid-cols-2 lg:items-start">
        <div class="space-y-8">
          <AvailabilityCalendar />
          {
            centre.hireRates.length > 0 && (
              <div class="rounded-2xl bg-teal-900 p-5 text-white shadow-lg shadow-teal-900/10 sm:p-6">
                <h3 class="font-display text-xl font-semibold">Hire rates</h3>
                <ul class="mt-4 space-y-2">
                  {centre.hireRates.map((rate) => (
                    <li class="flex items-center gap-3 text-teal-100">
                      <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-gold-500" aria-hidden="true" />
                      {rate}
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
        <HireForm hireIntro={centre.hireIntro} />
      </div>
    </div>
  </section>
</Base>
