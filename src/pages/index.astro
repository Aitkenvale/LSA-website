---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import EventCard from '../components/EventCard.astro';
import AnnouncementCard from '../components/AnnouncementCard.astro';
import { getSiteSettings } from '../lib/site';

const settings = await getSiteSettings();
const homeEntry = await getEntry('homepage', 'home');
if (!homeEntry) throw new Error('Missing home page content (src/content/homepage/home.yml)');
const home = homeEntry.data;
const now = new Date(); // build time; a daily cron rebuild keeps this fresh

const events = (await getCollection('events'))
  .filter((e) => (e.data.end ?? e.data.start) >= now)
  .sort((a, b) => a.data.start.getTime() - b.data.start.getTime());

const announcements = (await getCollection('announcements'))
  .filter((a) => !a.data.expires || a.data.expires >= now)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);
---

<Base description={settings.tagline}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-teal-900">
    <div
      class="absolute inset-0 bg-gradient-to-br from-teal-950 via-teal-900 to-teal-700"
      aria-hidden="true"
    >
    </div>
    <Logo class="absolute -right-16 -bottom-24 h-96 w-96 text-gold-500/10 sm:-right-8" />
    <div class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
      <div class="h-1 w-16 rounded bg-gold-500" aria-hidden="true"></div>
      <h1 class="font-display mt-6 max-w-3xl text-4xl leading-tight font-semibold text-white sm:text-6xl">
        {home.heroTitle}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-teal-100">{home.heroIntro}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#events"
          class="rounded-full bg-gold-500 px-6 py-3 text-sm font-semibold text-teal-950 shadow-md transition-colors hover:bg-gold-400"
        >
          {home.heroButtonEvents}
        </a>
        <a
          href="/what-we-believe/"
          class="rounded-full border border-teal-100/40 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10"
        >
          {home.heroButtonBelieve}
        </a>
      </div>
    </div>
  </section>

  <!-- Upcoming events -->
  <section id="events" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-14 sm:px-6">
    <div class="h-1 w-10 rounded bg-gold-500" aria-hidden="true"></div>
    <h2 class="font-display mt-4 text-3xl font-semibold text-teal-900">{home.eventsHeading}</h2>
    {
      events.length > 0 ? (
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {events.map((event) => (
            <EventCard event={event} />
          ))}
        </div>
      ) : (
        <p class="mt-6 text-ink/70">{home.eventsEmptyText}</p>
      )
    }
  </section>

  <!-- Announcements -->
  <section class="bg-teal-50/60">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <div class="h-1 w-10 rounded bg-gold-500" aria-hidden="true"></div>
      <h2 class="font-display mt-4 text-3xl font-semibold text-teal-900">{home.announcementsHeading}</h2>
      {
        announcements.length > 0 ? (
          <div class="mt-8 grid gap-5 lg:grid-cols-2">
            {announcements.map((a) => (
              <AnnouncementCard announcement={a} />
            ))}
          </div>
        ) : (
          <p class="mt-6 text-ink/70">{home.announcementsEmptyText}</p>
        )
      }
    </div>
  </section>

  <!-- Community Centre teaser -->
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="rounded-3xl bg-teal-900 px-6 py-10 sm:px-12 sm:py-14">
      <div class="md:flex md:items-center md:justify-between md:gap-8">
        <div>
          <h2 class="font-display text-2xl font-semibold text-white sm:text-3xl">
            {home.venueHeading}
          </h2>
          <p class="mt-3 max-w-xl text-teal-100">{home.venueText}</p>
        </div>
        <a
          href="/community-centre/"
          class="mt-6 inline-block shrink-0 rounded-full bg-gold-500 px-6 py-3 text-sm font-semibold text-teal-950 shadow-md transition-colors hover:bg-gold-400 md:mt-0"
        >
          {home.venueButton}
        </a>
      </div>
    </div>
  </section>
</Base>
