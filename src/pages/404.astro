---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
---

<Base title="Page not found">
  <section class="mx-auto flex max-w-6xl flex-col items-center px-4 py-24 text-center sm:px-6">
    <Logo class="h-16 w-16" />
    <h1 class="font-display mt-6 text-4xl font-semibold text-teal-900">Page not found</h1>
    <p class="mt-4 max-w-md text-ink/70">
      The page you're after doesn't exist or has moved.
    </p>
    <a
      href="/"
      class="mt-8 rounded-full bg-teal-700 px-6 py-3 text-sm font-semibold text-white shadow-md transition-colors hover:bg-teal-800"
    >
      Back to the home page
    </a>
  </section>
</Base>
