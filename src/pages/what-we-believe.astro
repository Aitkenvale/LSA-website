---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ContentPage from '../components/ContentPage.astro';

const page = await getEntry('pages', 'what-we-believe');
if (!page) throw new Error('Missing page content: src/content/pages/what-we-believe.md');
---

<Base
  title="What We Believe"
  description="The Bahá'í Faith teaches the oneness of God, the oneness of religion and the oneness of humanity."
>
  <ContentPage page={page.data} />
</Base>
