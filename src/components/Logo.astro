---
// Nine-pointed star mark — "mudcloth" design: open gold outline star with
// hand-drawn chevrons and a dotted ring. The default (simple) variant drops
// the interior marks so the mark stays crisp at header/footer sizes and
// follows currentColor; `detailed` renders the full emblem in brand colours.
interface Props {
  class?: string;
  detailed?: boolean;
}
const { class: className = 'h-8 w-8', detailed = false } = Astro.props;

const STAR =
  'M50.00 7.00L60.60 20.87L77.64 17.06L76.85 34.50L92.35 42.53L80.53 55.38L87.24 71.50L69.93 73.75L64.71 90.41L50.00 81.00L35.29 90.41L30.07 73.75L12.76 71.50L19.47 55.38L7.65 42.53L23.15 34.50L22.36 17.06L39.40 20.87Z';
---

{
  detailed ? (
    <svg viewBox="0 0 100 100" class={className} aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <path d={STAR} fill="none" stroke="#c9a227" stroke-width="5" stroke-linejoin="round" />
      <g stroke="#8a6d1d" stroke-width="2.6" fill="none" stroke-linecap="round">
        {Array.from({ length: 9 }, (_, i) => (
          <path d="M46 26 L50 20 L54 26" transform={`rotate(${i * 40} 50 50)`} />
        ))}
      </g>
      <circle cx="50" cy="50" r="10" fill="none" stroke="#c9a227" stroke-width="2.6" stroke-dasharray="0.1 5.1" stroke-linecap="round" />
      <circle cx="50" cy="50" r="3.4" fill="#0e6e6b" />
    </svg>
  ) : (
    <svg viewBox="0 0 100 100" class={className} aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <path d={STAR} fill="none" stroke="currentColor" stroke-width="6" stroke-linejoin="round" />
      <circle cx="50" cy="50" r="6" fill="currentColor" />
    </svg>
  )
}
