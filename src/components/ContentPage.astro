---
// Shared template for CMS-driven pages: hero + section blocks.
import type { ImageMetadata } from 'astro';
import PageHero from './PageHero.astro';
import SectionBlock from './SectionBlock.astro';

interface PageData {
  title: string;
  intro: string;
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
  sections: {
    heading: string;
    text: string;
    image?: ImageMetadata;
    imageAlt?: string;
    imageSide?: 'left' | 'right';
  }[];
}

interface Props {
  page: PageData;
}
const { page } = Astro.props;
const { title, intro, heroImage, heroImageAlt, sections } = page;
---

<PageHero title={title} intro={intro} image={heroImage} imageAlt={heroImageAlt} />
{
  sections.map((section) => (
    <SectionBlock
      heading={section.heading}
      text={section.text}
      image={section.image}
      imageAlt={section.imageAlt}
      flip={section.imageSide === 'left'}
    />
  ))
}
<slot />
