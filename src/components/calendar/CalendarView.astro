  }
  .cal-card span { color: color-mix(in srgb, var(--color-ink) 78%, transparent); }
  .cal-card .tip-when { color: var(--color-teal-700); font-weight: 500; }
  .cal-card .tip-badi { font-size: 0.74rem; opacity: 0.8; }
  /* The sunset note is the line a reader most needs to catch: an observance
     dated Saturday that in fact begins on Friday evening. */
  .cal-card .tip-eve {
    color: var(--color-gold-700);
    font-weight: 600;
    background: color-mix(in srgb, var(--color-gold-100) 60%, transparent);
    border-radius: 0.25rem;
    padding: 0.15rem 0.35rem;
    margin: 0 -0.1rem;
  }
  .cal-card .tip-work { color: var(--color-teal-800); font-weight: 500; }
  .cal-card .tip-caveat {
    font-size: 0.72rem;
    font-style: italic;
    color: color-mix(in srgb, var(--color-ink) 55%, transparent);
    border-top: 1px solid color-mix(in srgb, var(--color-teal-900) 10%, transparent);
    padding-top: 0.3rem;
    margin-top: 0.1rem;
  }

  .cal-status { font-size: 0.75rem; color: color-mix(in srgb, var(--color-ink) 60%, transparent); min-height: 1.2em; margin: 0.5rem 0 0; }

  .cal-legend {
    display: flex; flex-wrap: wrap; gap: 0.4rem 1rem;
    list-style: none; margin: 0.75rem 0 0; padding: 0;
    font-size: 0.72rem; color: color-mix(in srgb, var(--color-ink) 70%, transparent);
  }
  .cal-legend li { display: flex; align-items: center; gap: 0.35rem; }
  .swatch { width: 0.85rem; height: 0.85rem; border-radius: 0.2rem; border: 1px solid var(--cal-line); }
  /* These must match the washes painted in the cells, not the badge colours. */
  .swatch-holy { background: var(--cal-holy-tint); }
  .swatch-month { background: var(--cal-feast-tint); }
  .cal-legend-note { font-style: italic; }

  /* ---- administrator drawer ---------------------------------------------- */
  .cal-scrim {
    position: fixed; inset: 0; background: rgb(15 61 62 / 0.45); z-index: 40;
  }
  .cal-drawer {
    position: fixed; top: 0; right: 0; bottom: 0; z-index: 50;
    width: min(24rem, 100vw);
    background: var(--color-sand-50);
    box-shadow: -8px 0 24px rgb(15 61 62 / 0.18);
    display: flex; flex-direction: column;
    transform: translateX(100%);
