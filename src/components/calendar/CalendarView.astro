  .cal-day.from-feast { --cell-from: var(--feast); }
  .cal-day.to-holy { --cell-to: var(--holy); }
  .cal-day.to-feast { --cell-to: var(--feast); }

  /* Out-of-month days are tinted back rather than hidden, so a week that
