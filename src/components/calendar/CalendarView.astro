  .faith-hinduism { background-image: url('/icons/faith/hinduism.svg'); }
  .faith-islam { background-image: url('/icons/faith/islam.svg'); }
  .faith-jainism { background-image: url('/icons/faith/jainism.svg'); }
  .faith-judaism { background-image: url('/icons/faith/judaism.svg'); }
  .faith-orthodox { background-image: url('/icons/faith/orthodox.svg'); }
  .faith-sikhism { background-image: url('/icons/faith/sikhism.svg'); }

  .cal-other:hover, .cal-event:hover,
