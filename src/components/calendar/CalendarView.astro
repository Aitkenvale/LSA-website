  .cal-day-head .cal-greg { justify-self: start; }
  .cal-day-head .cal-badi { grid-column: 2; text-align: center; }
  .cal-greg {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-ink);
