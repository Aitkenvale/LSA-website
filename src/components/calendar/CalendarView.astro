---
/**
 * The community calendar — Gregorian view.
 *
 * PRESENTATION ONLY — expected to change. The current look was sketched from a
 * printed wall calendar purely as a starting point; that is a separate piece of
 * work with its own constraints and this page is not bound to it. Nothing below
 * the presentation layer depends on these choices: the calendar engines return
 * plain dated occurrences, so the whole view can be redesigned without touching
 * them.
 *
 * The ideas worth keeping, whatever the design becomes:
 *   - each cell shows both the Gregorian and the Badí‘ date;
 *   - Bahá'í days lead, and are distinguished from each other by hue;
 *   - all other traditions share one quiet subordinate style, rather than
 *     competing for attention with a colour each;
 *   - days outside the displayed month are tinted back, not hidden.
 */
---

<div class="calendar">
  <!--
    The three views the calendar will offer. Only the Gregorian one exists so
    far; the others are shown disabled rather than hidden so the shape of the
    thing is visible, and so nobody wonders where they went. The cycle view will
    additionally depend on the viewer's privileges.
  -->
  <nav class="cal-views" aria-label="Calendar view">
    <button type="button" class="cal-view is-current" aria-current="true">Gregorian</button>
    <button type="button" class="cal-view" disabled aria-disabled="true" title="Not built yet">Badí‘</button>
    <button type="button" class="cal-view" disabled aria-disabled="true" title="Not built yet">Cycle</button>
  </nav>

  <header class="cal-bar">
    <div class="cal-nav">
      <button type="button" class="cal-btn" data-nav="prev" aria-label="Previous month">‹</button>
      <button type="button" class="cal-btn cal-btn-text" data-nav="today">Today</button>
      <button type="button" class="cal-btn" data-nav="next" aria-label="Next month">›</button>
    </div>
    <div class="cal-heading">
      <h2 class="cal-title" data-title aria-live="polite">&nbsp;</h2>
      <p class="cal-badi-year" data-badi-year></p>
    </div>
    <div class="cal-actions">
      <button type="button" class="cal-icon-btn" data-open-signin aria-haspopup="dialog" title="Sign in">
        <span class="sr-only">Sign in</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="8" r="3.6" />
          <path d="M4.5 20a7.5 7.5 0 0 1 15 0" />
        </svg>
      </button>
      <button type="button" class="cal-burger" data-open-drawer aria-expanded="false" aria-controls="cal-drawer">
      <span class="sr-only">Choose calendars</span>
        <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
    </div>
  </header>

  <div class="cal-grid-wrap">
    <div class="cal-grid" data-grid role="grid" aria-label="Month view"></div>
  </div>

  <p class="cal-status" data-status role="status"></p>

  <!--
    Only the two washes a reader has to interpret. "Feast" was listed with the
    teal swatch and so was "Bahá'í month begins" — two names for one colour,
    left over from when the Feast was a computed calendar of its own. "Other
    faiths" showed a white swatch, which is to say no marking at all.
  -->
  <ul class="cal-legend">
    <li><span class="swatch swatch-holy"></span> Holy Day</li>
    <li><span class="swatch swatch-month"></span> Bahá’í month begins</li>
    <li class="cal-legend-note">* work suspended</li>
  </ul>

  <!--
    Signing in.

    The code is checked on the server and never reaches the page; what comes
    back is a signed cookie naming a tier. A reader who is not signed in sees
    the public calendar, which is the default rather than a fallback.
  -->
  <div class="cal-scrim" data-signin-scrim hidden></div>
  <div class="cal-signin" data-signin hidden role="dialog" aria-modal="true" aria-labelledby="cal-signin-title">
    <div class="cal-signin-head">
      <h3 id="cal-signin-title">Sign in</h3>
      <button type="button" class="cal-close" data-close-signin aria-label="Close">×</button>
    </div>
    <div class="cal-signin-body">
      <p class="cal-help">
        You are viewing as <strong data-tier-label>the public</strong>.
      </p>

      <div data-signin-form>
        <p class="cal-help">Enter the code for your group.</p>
        <label class="cal-field">
          Access code
          <input type="password" data-signin-code autocomplete="current-password" />
        </label>
        <button type="button" class="cal-primary" data-signin-submit>Sign in</button>
        <p class="cal-error" data-signin-error hidden></p>
      </div>

      <div data-signout-form hidden>
        <p class="cal-help">
          Signing out returns this device to the public calendar.
        </p>
        <button type="button" class="cal-secondary" data-signout>Sign out</button>
      </div>
    </div>
  </div>

  <!-- Administrator drawer -->
  <div class="cal-scrim" data-scrim hidden></div>
  <aside id="cal-drawer" class="cal-drawer" data-drawer hidden aria-label="Calendars">
    <div class="cal-drawer-head">
      <h3>Calendars</h3>
      <button type="button" class="cal-close" data-close-drawer aria-label="Close settings">×</button>
    </div>

    <div class="cal-drawer-body" data-drawer-body>
      <!--
        Choosing which calendars to see is a reader's decision, not an
        administrator's — the drawer opens for everyone and this section is
        always available. Only configuration sits behind the code below.
      -->
      <section>
        <h4>Show calendars</h4>
        <p class="cal-help">
          Choose which calendars appear, and drag them into the order you want.
          Your choices are remembered on this device only, and do not change
          what anyone else sees.
        </p>
        <div class="cal-list" data-public-list></div>
      </section>

      <details class="cal-admin-block">
        <summary>Administrator settings</summary>

        <section class="cal-lock" data-lock>
          <p class="cal-help">These settings are for Assembly administrators.</p>
          <label>
            Administrator code
            <input type="password" data-admin-input autocomplete="off" />
          </label>
          <button type="button" class="cal-primary" data-admin-submit>Unlock</button>
          <p class="cal-error" data-admin-error hidden>That code was not recognised.</p>
        </section>

        <div data-admin-panel hidden>
          <section>
            <h4>Linked calendars</h4>
            <p class="cal-help">
              Calendars kept in Google or in Outlook, read by their
              <strong>private iCal address</strong>.
            </p>
            <ul class="cal-help cal-where">
              <li>
                <strong>Google Calendar</strong> — Settings → Integrate calendar →
                Secret address in iCal format
              </li>
              <li>
                <strong>Outlook</strong> — Settings → Calendar → Shared calendars →
                Publish a calendar → choose <em>Can view all details</em>, then take
                the ICS link
              </li>
            </ul>
            <p class="cal-help">
              Either address lets anyone holding it read the calendar without signing
              in, so treat it as a password. To revoke one, unpublish and republish
              the calendar — that issues a new address and kills the old one.
            </p>
            <div class="cal-list" data-google-list></div>

            <div class="cal-add">
              <h5>Add New Calendar</h5>
              <label class="cal-field">
                Calendar name
                <input type="text" data-new-name placeholder="LSA Meetings" />
              </label>
              <label class="cal-field">
                View label
                <input type="text" data-new-view-label placeholder="LSA Meeting" />
                <small>Leave empty to show real event titles.</small>
              </label>
              <label class="cal-field">
                Private iCal address
                <input type="url" data-new-url placeholder="https://calendar.google.com/… or https://outlook.office365.com/…" />
              </label>
              <button type="button" class="cal-primary" data-add-google>Add calendar</button>
              <p class="cal-error" data-google-error hidden></p>
            </div>
          </section>

          <section>
            <h4>Dates to confirm</h4>
            <p class="cal-help">
              These dates depend on local observation or regional custom, so the
              calendar shows its best calculation until someone confirms them.
              Copy a reference below, then record the announced date under
              <strong>Calendar verified dates</strong> in the site's content
              editor. Confirming a date without changing it is worth doing too — it
              removes the “approximate” mark.
            </p>
            <label class="cal-field">
              Show dates for
              <select data-verify-window>
                <option value="12">the next 12 months</option>
                <option value="24">the next 2 years</option>
              </select>
            </label>
            <div class="cal-list" data-verify-list></div>
          </section>

          <section>
            <h4>How these settings are stored</h4>
            <p class="cal-help">
              Changes here are saved <strong>for everyone</strong>, straight away.
              Calendar names, addresses, colours, order and who may see what are
              the community's settings, not this device's.
            </p>
            <p class="cal-help">
              A reader's own choices — which calendars they have switched on, and
              which sections they have collapsed — stay on their own device and
              affect nobody else.
            </p>
            <button type="button" class="cal-secondary" data-copy-config>Copy configuration as a backup</button>
            <span class="cal-copied" data-copied hidden>Copied</span>
          </section>
        </div>
      </details>
    </div>
  </aside>
</div>

<script>
  import {
    CALENDAR_COLOURS,
    CALENDAR_SECTIONS,
    calendarColour,
    isSeededCalendar,
  } from '../../lib/calendar/registry';
  import type { StoredCalendar, StoredConfig, VisibleCalendar } from '../../lib/calendar/config-store';
  import { TIERS, TIER_LABELS, type Tier } from '../../lib/calendar/tiers';
  import { gregorianToBadi, formatBadiDate, nawRuz } from '../../lib/calendar/badi';
  import { addDays, isoDate, parseIso, weekday } from '../../lib/calendar/astronomy';
  import type { Occurrence } from '../../lib/calendar/types';
  import type { IcsEvent } from '../../lib/calendar/ics';

  /**
   * Only preferences live here now.
   *
   * Which calendars exist, what they are called and who may see them is the
   * community's, not this device's — it comes from the server and an
   * administrator sets it once for everyone. What stays local is which
   * calendars this reader has switched on and which sections they have
   * collapsed: nobody else is affected by either.
   */
  const PREFS_KEY = 'townsville-calendar-prefs';

  interface Prefs {
    enabled: Record<string, boolean>;
    sectionsOpen: Record<string, boolean>;
  }

  /** What the configuration endpoint returns, depending on who is asking. */
  interface ConfigResponse {
    tier: Tier;
    admin: boolean;
    calendars?: VisibleCalendar[];
    config?: StoredConfig;
  }

  const MONTH_NAMES = [
    'January', 'February', 'March', 'April', 'May', 'June',
    'July', 'August', 'September', 'October', 'November', 'December',
  ];
  const WEEKDAY_NAMES = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

  /** Calendars that have a symbol to sit beside their entries. */
  const FAITHS_WITH_ICONS = new Set([
    'buddhism', 'christian', 'hinduism', 'islam',
    'jainism', 'judaism', 'orthodox', 'sikhism',
  ]);

  /** An event as rendered, whatever its source. */
  interface Entry {
    calendarId: string;
    name: string;
    group: 'bahai' | 'other-faith' | 'community';
    kind: 'holy-day' | 'feast' | 'month' | 'other' | 'event';
    workSuspended?: boolean;
    note?: string;
    approximate?: boolean;
    verified?: boolean;
    time?: string;
    badge?: string;
    /** Dot colour, for calendars linked from Google or Outlook. */
    colour?: string;
    /** Observance begins at sunset on the evening before this date. */
    startsPreviousEvening?: boolean;
    /** Full text for the hover card. */
    tip?: string;
  }

  /** Which kind of Bahá'í observance an evening leads into. */
  type EveKind = 'holy' | 'feast';

  function init(root: HTMLElement) {
    const prefs = loadPrefs();
    /** What the server says this reader may see. Refreshed when the tier changes. */
    let server: ConfigResponse = { tier: 'public', admin: false, calendars: [] };

    /** The calendars this reader may see, in the order the community set. */
    const listed = (): VisibleCalendar[] => server.calendars ?? [];
    const linkedCalendars = () => listed().filter((c) => c.kind === 'linked');

    /**
     * Whether a reader has this calendar switched on. Their own choice wins;
     * otherwise the calendar's own default, so a first visit is not blank.
     */
    const isEnabled = (id: string): boolean =>
      prefs.enabled[id] ?? listed().find((c) => c.id === id)?.defaultOn ?? false;

    async function loadServerConfig(): Promise<void> {
      try {
        const res = await fetch('/api/calendar-config.json');
        const body = (await res.json()) as ConfigResponse;
        // An administrator receives the whole document, including addresses;
        // everyone else receives only what their tier may know. Both are
        // normalised to the same list for rendering.
        server = body.admin && body.config
          ? { ...body, calendars: adminView(body.config) }
          : body;
      } catch {
        server = { tier: 'public', admin: false, calendars: [] };
      }
    }

    /** An administrator's full document, shaped like the reader's list. */
    function adminView(config: StoredConfig): VisibleCalendar[] {
      return [...config.calendars]
        .sort((a, b) => a.position - b.position)
        .map((c) => ({
          id: c.id,
          kind: c.kind,
          name: c.name ?? c.id,
          defaultOn: true,
          colour: c.colour,
          section: c.section ?? 'bahai',
          showsDetail: true,
          viewLabel: c.viewLabel,
          after: c.after,
          position: c.position,
        }));
    }
    let cursor = startOfMonth(todayIso());
    /*
     * Whether the administrator panel is open is the server's answer, not a
     * flag this page keeps. Previously a value in sessionStorage decided it,
     * which meant the page could show itself the panel; now it can only show
     * what a session the server recognises entitles it to.
     */

    const grid = root.querySelector<HTMLElement>('[data-grid]')!;
    const title = root.querySelector<HTMLElement>('[data-title]')!;
    const badiYearEl = root.querySelector<HTMLElement>('[data-badi-year]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;

    // ---- navigation -------------------------------------------------------
    root.querySelector('[data-nav="prev"]')!.addEventListener('click', () => {
      cursor = shiftMonth(cursor, -1);
      void render();
    });
    root.querySelector('[data-nav="next"]')!.addEventListener('click', () => {
      cursor = shiftMonth(cursor, 1);
      void render();
    });
    root.querySelector('[data-nav="today"]')!.addEventListener('click', () => {
      cursor = startOfMonth(todayIso());
      void render();
    });

    // ---- drawer -----------------------------------------------------------
    const drawer = root.querySelector<HTMLElement>('[data-drawer]')!;
    const scrim = root.querySelector<HTMLElement>('[data-scrim]')!;
    const burger = root.querySelector<HTMLButtonElement>('[data-open-drawer]')!;
    const lock = root.querySelector<HTMLElement>('[data-lock]')!;
    const panel = root.querySelector<HTMLElement>('[data-admin-panel]')!;

    function openDrawer() {
      drawer.hidden = false;
      scrim.hidden = false;
      burger.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => drawer.classList.add('is-open'));
      syncPublicToggles();
      syncLock();
    }
    function closeDrawer() {
      drawer.classList.remove('is-open');
      burger.setAttribute('aria-expanded', 'false');
      setTimeout(() => {
        drawer.hidden = true;
        scrim.hidden = true;
      }, 200);
    }
    burger.addEventListener('click', openDrawer);
    scrim.addEventListener('click', closeDrawer);
    root.querySelector('[data-close-drawer]')!.addEventListener('click', closeDrawer);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer.hidden) closeDrawer();
    });

    function syncLock() {
      lock.hidden = server.admin;
      panel.hidden = !server.admin;
      if (server.admin) {
        // The administrator's document — with addresses — only arrives once the
        // server has recognised the session, so re-ask before drawing it.
        void loadServerConfig().then(() => {
          renderGoogleList();
          syncPublicToggles();
          void renderVerifyList();
          void render();
        });
      }
    }

    const verifyList = root.querySelector<HTMLElement>('[data-verify-list]')!;
    const verifyWindow = root.querySelector<HTMLSelectElement>('[data-verify-window]')!;
    verifyWindow.addEventListener('change', () => void renderVerifyList());

    /** List the occurrences still resting on a calculation, so they can be confirmed. */
    async function renderVerifyList() {
      const months = Number(verifyWindow.value) || 12;
      const from = todayIso();
      const to = shiftMonth(startOfMonth(from), months);
      verifyList.innerHTML = '<p class="cal-help">Loading…</p>';
      let occurrences: Occurrence[];
      try {
        const res = await fetch(`/api/holy-days.json?from=${from}&to=${to}`);
        occurrences = ((await res.json()) as { occurrences: Occurrence[] }).occurrences;
      } catch {
        verifyList.innerHTML = '<p class="cal-help">Could not load dates.</p>';
        return;
      }
      const pending = occurrences.filter((o) => o.confidence === 'approximate');
      const verified = occurrences.filter((o) => o.confidence === 'verified').length;

      if (!pending.length) {
        verifyList.innerHTML = `<p class="cal-help">Every date in this window is exact or confirmed${verified ? ` (${verified} confirmed)` : ''}.</p>`;
        return;
      }
      verifyList.innerHTML =
        `<p class="cal-help">${pending.length} calculated ${pending.length === 1 ? 'date' : 'dates'}${verified ? `, ${verified} already confirmed` : ''}.</p>` +
        pending
          .map(
            (o) => `
            <div class="cal-item cal-verify-row">
              <div class="cal-verify-name">${escapeHtml(o.name)}</div>
              <div class="cal-desc">${formatLongDate(o.date)}${o.endDate ? ` – ${formatLongDate(o.endDate)}` : ''}</div>
              <button type="button" class="cal-key" data-copy-key="${escapeHtml(o.calendarId)}:${escapeHtml(o.key)}">
                ${escapeHtml(o.calendarId)}:${escapeHtml(o.key)}
              </button>
            </div>`,
          )
          .join('');
    }

    verifyList.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-copy-key]');
      if (!btn) return;
      try {
        await navigator.clipboard.writeText(btn.dataset.copyKey!);
        const original = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(() => (btn.textContent = original), 1200);
      } catch {
        /* clipboard unavailable — the reference is still visible to select */
      }
    });

    const adminInput = root.querySelector<HTMLInputElement>('[data-admin-input]')!;
    const adminError = root.querySelector<HTMLElement>('[data-admin-error]')!;
    // The code is held in a Worker secret and checked on the server — it is
    // never sent to the browser, so it cannot be read out of the page.
    async function tryUnlock() {
      adminError.hidden = true;
      try {
        const res = await fetch('/api/calendar-admin.json', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ code: adminInput.value }),
        });
        const body = (await res.json()) as { ok?: boolean; error?: string };
        if (!body.ok) {
          adminError.textContent = body.error ?? 'That code was not recognised.';
          adminError.hidden = false;
          return;
        }
        adminInput.value = '';
        // The cookie the server just set is what makes this an administrator;
        // asking again is how the page finds out.
        await loadServerConfig();
        syncLock();
      } catch {
        adminError.textContent = 'Could not check the code just now.';
        adminError.hidden = false;
      }
    }
    root.querySelector('[data-admin-submit]')!.addEventListener('click', () => void tryUnlock());
    adminInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') void tryUnlock();
    });

    // ---- generated calendar settings --------------------------------------
    /**
     * The reader-facing on/off list, gathered under section headings and
     * rearrangeable by dragging.
     *
     * Rebuilt whenever the drawer opens, because Google calendars are
     * interleaved with the generated ones and an administrator may have just
     * added or removed one.
     */
    const publicList = root.querySelector<HTMLElement>('[data-public-list]')!;

    function syncPublicToggles() {
      const entries = listed();
      publicList.innerHTML = '';

      for (const section of CALENDAR_SECTIONS) {
        const inSection = entries.filter((e) => e.section === section.id);
        const block = document.createElement('details');
        block.className = 'cal-section';
        block.open = prefs.sectionsOpen[section.id] !== false;
        block.dataset.section = section.id;
        block.innerHTML =
          `<summary>${escapeHtml(section.label)}` +
          `<span class="cal-section-count">${inSection.length}</span></summary>` +
          '<div class="cal-list" data-drop></div>';
        block.addEventListener('toggle', () => {
          prefs.sectionsOpen[section.id] = block.open;
          savePrefs(prefs);
        });

        const list = block.querySelector<HTMLElement>('[data-drop]')!;

        if (!inSection.length) {
          list.innerHTML = '<p class="cal-help cal-empty">Drag a calendar here.</p>';
        }

        for (const entry of inSection) {
          const on = isEnabled(entry.id);

          const row = document.createElement('div');
          row.className = 'cal-item cal-toggle-row';
          row.draggable = server.admin;
          row.dataset.id = entry.id;
          row.innerHTML =
            (server.admin ? '<span class="cal-grip" aria-hidden="true">⠿</span>' : '') +
            `<label class="cal-toggle"><input type="checkbox" ${on ? 'checked' : ''} />` +
            `<span class="cal-toggle-name">${escapeHtml(entry.name)}</span></label>` +
            (entry.confidence === 'approximate' ? '<span class="cal-tag">approximate</span>' : '');

          row.querySelector('input')!.addEventListener('change', (e) => {
            prefs.enabled[entry.id] = (e.target as HTMLInputElement).checked;
            savePrefs(prefs);
            void render();
          });
          list.appendChild(row);
        }
        publicList.appendChild(block);
      }
      wireDragging();
    }

    /**
     * Drag to reorder, and to move a calendar between sections.
     *
     * Order is held as one flat list of ids spanning every section, so a
     * calendar dropped into a different section both moves and lands in the
     * right place within it.
     */
    let dragging: string | null = null;

    function wireDragging() {
      // Only an administrator may rearrange, so only they get the handles.
      if (!server.admin) return;
      for (const row of publicList.querySelectorAll<HTMLElement>('[data-id]')) {
        row.addEventListener('dragstart', (e) => {
          dragging = row.dataset.id!;
          row.classList.add('is-dragging');
          (e as DragEvent).dataTransfer?.setData('text/plain', dragging);
        });
        row.addEventListener('dragend', () => {
          dragging = null;
          row.classList.remove('is-dragging');
          for (const el of publicList.querySelectorAll('.is-over')) el.classList.remove('is-over');
        });
        row.addEventListener('dragover', (e) => {
          e.preventDefault();
          if (dragging && dragging !== row.dataset.id) row.classList.add('is-over');
        });
        row.addEventListener('dragleave', () => row.classList.remove('is-over'));
        row.addEventListener('drop', (e) => {
          e.preventDefault();
          e.stopPropagation();
          row.classList.remove('is-over');
          if (!dragging || dragging === row.dataset.id) return;
          const section = row.closest<HTMLElement>('[data-section]')!.dataset.section!;
          void dropOnto(dragging, row.dataset.id!, section);
        });
      }
      // Dropping on the section itself appends to its end, which is the only
      // way to reach a section that is currently empty.
      for (const block of publicList.querySelectorAll<HTMLElement>('[data-section]')) {
        block.addEventListener('dragover', (e) => e.preventDefault());
        block.addEventListener('drop', (e) => {
          e.preventDefault();
          if (dragging) void dropOnto(dragging, null, block.dataset.section!);
        });
      }
    }

    /**
     * Reordering is an administrator's act, not a reader's: the order and the
     * sections are how the community presents its calendars, the same for
     * everyone. Readers choose only what to switch on.
     */
    async function dropOnto(movedId: string, beforeId: string | null, section: string) {
      if (!server.admin || !server.config) return;
      const ids = listed().map((e) => e.id);
      const without = ids.filter((id) => id !== movedId);
      const at = beforeId ? without.indexOf(beforeId) : -1;
      without.splice(at === -1 ? without.length : at, 0, movedId);

      const config = server.config;
      without.forEach((id, index) => {
        const entry = config.calendars.find((c) => c.id === id);
        if (entry) entry.position = (index + 1) * 10;
      });
      const moved = config.calendars.find((c) => c.id === movedId);
      if (moved) moved.section = section as 'bahai' | 'interfaith' | 'secular';

      await saveServerConfig(config);
      syncPublicToggles();
      void render();
    }

    /** Write the shared document back. Refused by the server below admin. */
    async function saveServerConfig(config: StoredConfig): Promise<boolean> {
      try {
        const res = await fetch('/api/calendar-config.json', {
          method: 'PUT',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(config),
        });
        if (!res.ok) return false;
        const body = (await res.json()) as { ok: boolean; config: StoredConfig };
        if (!body.ok) return false;
        server = { ...server, config: body.config, calendars: adminView(body.config) };
        return true;
      } catch {
        return false;
      }
    }


    // ---- Google calendars --------------------------------------------------
    const googleList = root.querySelector<HTMLElement>('[data-google-list]')!;
    const googleError = root.querySelector<HTMLElement>('[data-google-error]')!;

    function renderGoogleList() {
      googleList.innerHTML = '';
      const config = server.config;
      if (!config) {
        googleList.innerHTML = '<p class="cal-help">Sign in as an administrator to manage calendars.</p>';
        return;
      }
      const linked = config.calendars.filter((c) => c.kind === 'linked');
      if (!linked.length) {
        googleList.innerHTML = '<p class="cal-help">No calendars linked yet.</p>';
        return;
      }

      for (const cal of linked) {
        const fixed = isSeededCalendar(cal.id);
        const row = document.createElement('details');
        row.className = 'cal-item';
        row.innerHTML = `
          <summary>
            <span class="cal-dot" data-g-dot style="--dot:${calendarColour(cal.colour)}"></span>
            <span class="cal-toggle-name">${escapeHtml(cal.name ?? cal.id)}</span>
            <span class="cal-tag">${cal.icsUrl?.trim() ? 'connected' : 'no address'}</span>
          </summary>
          <label class="cal-field">
            Display name
            <input type="text" data-g-name value="${escapeHtml(cal.name ?? '')}" />
          </label>
          <label class="cal-field">
            View label
            <input type="text" data-g-view value="${escapeHtml(cal.viewLabel ?? '')}" placeholder="Show full detail" />
            <small>Shown instead of each event's real title, to anyone below the detail tier.</small>
          </label>
          <label class="cal-field">
            Private iCal address
            <input type="url" data-g-url value="${escapeHtml(cal.icsUrl ?? '')}"
              placeholder="https://calendar.google.com/… or https://outlook.office365.com/…" />
          </label>
          <label class="cal-field">
            Who can see this calendar
            <select data-g-visibility>
              ${TIERS.map((t) => `<option value="${t}"${cal.visibility === t ? ' selected' : ''}>${TIER_LABELS[t]}</option>`).join('')}
            </select>
          </label>
          <label class="cal-field">
            Who sees real event titles
            <select data-g-detail>
              ${TIERS.map((t) => `<option value="${t}"${cal.detailFrom === t ? ' selected' : ''}>${TIER_LABELS[t]}</option>`).join('')}
            </select>
            <small>Below this, the view label is sent instead — the real title never leaves the server.</small>
          </label>
          <div class="cal-field">
            Colour
            <div class="cal-swatches" data-g-colours>
              ${CALENDAR_COLOURS.map(
                (c) =>
                  `<button type="button" class="cal-swatch${(cal.colour ?? 'blue') === c.id ? ' is-current' : ''}"` +
                  ` data-colour="${c.id}" style="background:${c.value}" title="${c.label}">` +
                  `<span class="sr-only">${c.label}</span></button>`,
              ).join('')}
            </div>
          </div>
          <p class="cal-error" data-g-error hidden></p>
          ${
            fixed
              ? '<p class="cal-desc cal-fixed">Always available — the Feast and the Holy Days are ' +
                'fixtures of community life, so this cannot be removed. Clear the address to hide it.</p>'
              : '<button type="button" class="cal-remove" data-g-remove>Remove this calendar</button>'
          }`;

        const err = row.querySelector<HTMLElement>('[data-g-error]')!;
        const urlInput = row.querySelector<HTMLInputElement>('[data-g-url]')!;
        const summaryName = row.querySelector<HTMLElement>('.cal-toggle-name')!;
        const summaryTag = row.querySelector<HTMLElement>('.cal-tag')!;
        const summaryDot = row.querySelector<HTMLElement>('[data-g-dot]')!;

        const commit = async () => {
          const url = urlInput.value.trim();
          err.hidden = true;
          if (url && !isSupportedFeedUrl(url)) {
            err.textContent =
              'That must be a Google Calendar or Outlook iCal address (calendar.google.com or outlook.office365.com).';
            err.hidden = false;
            return;
          }
          cal.name = row.querySelector<HTMLInputElement>('[data-g-name]')!.value.trim() || cal.name;
          cal.viewLabel = row.querySelector<HTMLInputElement>('[data-g-view]')!.value.trim();
          cal.icsUrl = url;
          cal.visibility = row.querySelector<HTMLSelectElement>('[data-g-visibility]')!.value as Tier;
          cal.detailFrom = row.querySelector<HTMLSelectElement>('[data-g-detail]')!.value as Tier;

          // Updated in place rather than by rebuilding the list, which would
          // replace the row being edited and throw away focus mid-edit.
          summaryName.textContent = cal.name ?? cal.id;
          summaryTag.textContent = cal.icsUrl.trim() ? 'connected' : 'no address';

          if (!(await saveServerConfig(config))) {
            err.textContent = 'Could not save. Your administrator session may have expired.';
            err.hidden = false;
            return;
          }
          syncPublicToggles();
          void render();
        };
        for (const input of row.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select')) {
          input.addEventListener('change', () => void commit());
        }

        row.querySelector('[data-g-colours]')!.addEventListener('click', (e) => {
          const swatch = (e.target as HTMLElement).closest<HTMLElement>('[data-colour]');
          if (!swatch) return;
          cal.colour = swatch.dataset.colour!;
          for (const other of row.querySelectorAll('.cal-swatch')) {
            other.classList.toggle('is-current', other === swatch);
          }
          summaryDot.style.setProperty('--dot', calendarColour(cal.colour));
          void saveServerConfig(config).then(() => {
            syncPublicToggles();
            void render();
          });
        });

        row.querySelector('[data-g-remove]')?.addEventListener('click', async () => {
          const ok = window.confirm(
            `Remove \u201c${cal.name}\u201d from this calendar?\n\n` +
              'The calendar itself is not deleted — it stays in Google or Outlook. ' +
              'Only the link to it is removed from here, along with its address.',
          );
          if (!ok) return;
          config.calendars = config.calendars.filter((c) => c.id !== cal.id);
          await saveServerConfig(config);
          renderGoogleList();
          syncPublicToggles();
          void render();
        });
        googleList.appendChild(row);
      }
    }

    root.querySelector('[data-add-google]')!.addEventListener('click', async () => {
      const nameEl = root.querySelector<HTMLInputElement>('[data-new-name]')!;
      const urlEl = root.querySelector<HTMLInputElement>('[data-new-url]')!;
      const viewEl = root.querySelector<HTMLInputElement>('[data-new-view-label]')!;
      const name = nameEl.value.trim();
      const icsUrl = urlEl.value.trim();
      googleError.hidden = true;
      if (!server.config) return;
      if (!name || !icsUrl) {
        googleError.textContent = 'A name and an iCal address are both needed.';
        googleError.hidden = false;
        return;
      }
      if (!isSupportedFeedUrl(icsUrl)) {
        googleError.textContent =
          'That must be a Google Calendar or Outlook iCal address (calendar.google.com or outlook.office365.com).';
        googleError.hidden = false;
        return;
      }
      const config = server.config;
      config.calendars.push({
        id: `c${Date.now().toString(36)}`,
        kind: 'linked',
        name,
        icsUrl,
        viewLabel: viewEl.value.trim(),
        colour: 'blue',
        section: 'bahai',
        // A newly linked calendar starts closed. Opening it up has to be a
        // decision, not something that happens by pasting an address.
        visibility: 'assembly',
        detailFrom: 'assembly',
        position: Math.max(0, ...config.calendars.map((c) => c.position)) + 10,
      });
      if (!(await saveServerConfig(config))) {
        googleError.textContent = 'Could not save. Your administrator session may have expired.';
        googleError.hidden = false;
        return;
      }
      nameEl.value = '';
      urlEl.value = '';
      viewEl.value = '';
      renderGoogleList();
      syncPublicToggles();
      void render();
    });

    root.querySelector('[data-copy-config]')!.addEventListener('click', async () => {
      const copied = root.querySelector<HTMLElement>('[data-copied]')!;
      try {
        // The whole shared document, addresses included — an administrator can
        // already see those, and a backup without them would be no use.
        await navigator.clipboard.writeText(JSON.stringify(server.config ?? {}, null, 2));
        copied.hidden = false;
        setTimeout(() => (copied.hidden = true), 2000);
      } catch {
        /* clipboard unavailable — nothing useful to do */
      }
    });

    // ---- rendering ---------------------------------------------------------
    async function render() {
      const { year, month } = parseIso(cursor);
      title.textContent = `${MONTH_NAMES[month - 1]} ${year}`;

      const first = cursor;
      const gridStart = addDays(first, -weekday(first));
      const gridEnd = addDays(gridStart, 41);

      const badiStart = gregorianToBadi(first);
      badiYearEl.textContent = `${badiStart.year} B.E. · Naw-Rúz ${formatLongDate(nawRuz(badiStart.year))}`;

      // Paint the grid immediately so navigation feels instant, then fill it in.
      const byDate = new Map<string, Entry[]>();
      paint(gridStart, gridEnd, first, byDate, new Map());

      status.textContent = 'Loading…';
      try {
        const entries = await loadEntries(gridStart, gridEnd);
        status.textContent = entries.warning ?? '';
        paint(gridStart, gridEnd, first, entries.byDate, entries.eve);
      } catch {
        status.textContent = 'Could not load calendar dates.';
      }
    }

    async function loadEntries(from: string, to: string) {
      const byDate = new Map<string, Entry[]>();
      // A Bahá'í day begins at sunset, so the evening before a Holy Day or
      // Feast already belongs to it. That evening is shaded in the previous
      // day's cell rather than given an entry of its own.
      const eve = new Map<string, EveKind>();
      let warning: string | undefined;

      const res = await fetch(`/api/holy-days.json?from=${from}&to=${to}`);
      const data = (await res.json()) as { occurrences: Occurrence[] };

      for (const o of data.occurrences) {
        if (!isEnabled(o.calendarId)) continue;
        const kind =
          o.calendarId === 'bahai-holy-days' ? 'holy-day'
          : o.calendarId === 'bahai-feast' ? 'feast'
          : o.calendarId === 'bahai-months' ? 'month'
          : 'other';
        const group = o.calendarId.startsWith('bahai') ? 'bahai' : 'other-faith';
        // A calendar with a view label shows that label instead of the real name.
        const name = o.name;

        if (o.startsPreviousEvening && (kind === 'holy-day' || kind === 'month')) {
          const evening = addDays(o.date, -1);
          // A Holy Day's evening outranks a Feast's where both fall together.
          if (kind === 'holy-day' || !eve.has(evening)) {
            eve.set(evening, kind === 'holy-day' ? 'holy' : 'feast');
          }
        }

        for (const day of spanDays(o.date, o.endDate)) {
          // Month and multi-day entries only mark their first day in this view.
          if (kind === 'month' && day !== o.date) continue;
          push(byDate, day, {
            calendarId: o.calendarId,
            name,
            group,
            kind,
            workSuspended: o.workSuspended,
            note: o.note,
            approximate: o.confidence === 'approximate',
            verified: o.confidence === 'verified',
            startsPreviousEvening: o.startsPreviousEvening,
            badge: badgeFor(o, kind),
            tip: buildTip({ ...o, name }, group),
          });
        }
      }

      const failures: string[] = [];
      await Promise.all(
        // Asked for by id, never by address. The server holds the address, checks
        // this reader is entitled to the calendar, and applies the view label
        // before answering — so a title this reader may not see never arrives.
        linkedCalendars().filter((c) => isEnabled(c.id)).map(async (cal) => {
          try {
            const q = new URLSearchParams({ id: cal.id, from, to });
            const r = await fetch(`/api/calendar-feed.json?${q}`);
            const body = (await r.json()) as { events?: IcsEvent[]; error?: string };
            if (!r.ok || !body.events) {
              failures.push(cal.name);
              return;
            }
            for (const ev of body.events) {
              for (const day of spanDays(ev.date, ev.endDate)) {
                push(byDate, day, {
                  calendarId: cal.id,
                  // Already substituted server-side where this reader is not
                  // entitled to the real title, so there is nothing to hide here.
                  name: ev.summary,
                  group: 'community',
                  kind: 'event',
                  time: ev.startTime,
                  note: ev.location,
                  colour: calendarColour(cal.colour),
                  tip: !cal.showsDetail
                    ? `title|${ev.summary}`
                    : [
                        `title|${ev.summary}`,
                        `when|${formatEventTime(ev)}`,
                        // Outlook sends DESCRIPTION:\n for an empty description,
                        // which is truthy until it is trimmed.
                        ev.location?.trim() ? `note|${ev.location.trim()}` : '',
                        ev.description?.trim() ? `note|${ev.description.trim()}` : '',
                      ]
                        .filter(Boolean)
                        .join('\n'),
                });
              }
            }
          } catch {
            failures.push(cal.name);
          }
        }),
      );
      if (failures.length) warning = `Could not load: ${failures.join(', ')}.`;
      return { byDate, eve, warning };
    }

    function paint(
      gridStart: string,
      gridEnd: string,
      monthFirst: string,
      byDate: Map<string, Entry[]>,
      eve: Map<string, EveKind>,
    ) {
      const { month } = parseIso(monthFirst);
      const today = todayIso();
      const parts: string[] = [];

      for (const name of WEEKDAY_NAMES) {
        parts.push(`<div class="cal-weekday" role="columnheader">${name}</div>`);
      }

      let day = gridStart;
      while (day <= gridEnd) {
        const d = parseIso(day);
        const inMonth = d.month === month;
        const entries = byDate.get(day) ?? [];
        const holy = entries.some((e) => e.kind === 'holy-day');
        // A Bahá'í month beginning carries the same weight as the Feast that
        // normally falls on it, and is a computed fact rather than something a
        // community has to enter, so it keeps the tint and the month's badge.
        const monthStart = entries.some((e) => e.kind === 'month');
        const special = holy || monthStart;

        const classes = ['cal-day'];
        if (!inMonth) classes.push('is-out');
        if (day === today) classes.push('is-today');

        // Two independent facts about a cell, because a Bahá'í day runs sunset
        // to sunset and so straddles two Gregorian ones:
        //   `from` — what this day already is, having begun last night;
        //   `to`   — what its own evening leads into.
        // The band is then drawn left to right across the pair.
        const from = holy ? 'holy' : monthStart ? 'feast' : null;
        const evening = eve.get(day) ?? null;
        if (from) classes.push(`from-${from}`);
        if (evening) classes.push(`to-${evening}`);

        const badi = gregorianToBadi(day);
        const holyEntry = entries.find((e) => e.kind === 'holy-day');
        const feastEntry = entries.find((e) => e.kind === 'feast');
        const headTip = holyEntry?.tip ?? feastEntry?.tip ??
          (evening
            ? `title|${formatBadiDate(badi)}\neve|${evening === 'holy' ? 'A Holy Day' : 'A Feast'} begins at sunset this evening.`
            : '');
        // On a Holy Day the Badí' date is replaced by the Holy Day's name —
        // the name is what matters on that day.
        const badiLine = holyEntry ? holyEntry.name : formatBadiDate(badi);

        const badges = entries
          .filter((e) => e.badge)
          .map((e) => `<span class="cal-badge cal-badge-${e.kind}">${escapeHtml(e.badge!)}</span>`)
          .join('');

        const others = entries
          .filter((e) => e.group === 'other-faith')
          .map(
            (e) => `<li class="cal-other${e.approximate ? ' is-approx' : ''}" tabindex="0" data-tip="${escapeHtml(e.tip ?? e.name)}">` +
              // Only the faith calendars have a mark; a secular one would
              // otherwise reserve the space and sit oddly indented.
              (FAITHS_WITH_ICONS.has(e.calendarId)
                ? `<span class="faith-icon faith-${escapeHtml(e.calendarId)}" aria-hidden="true"></span>`
                : '') +
              `<span>${escapeHtml(keepNameWhole(e.name))}</span></li>`,
          )
          .join('');

        const events = entries
          .filter((e) => e.group === 'community')
          .map(
            (e) => `<li class="cal-event" tabindex="0" data-tip="${escapeHtml(e.tip ?? e.name)}">` +
              `<span class="cal-dot"${e.colour ? ` style="--dot:${escapeHtml(e.colour)}"` : ''}></span>` +
              `<span>${escapeHtml(keepNameWhole(e.name))}</span></li>`,
          )
          .join('');

        parts.push(`
          <div class="${classes.join(' ')}" role="gridcell">
            <div class="cal-day-head">
              <span class="cal-greg">${d.day}</span>
              <span class="cal-badi"${headTip ? ` tabindex="0" data-tip="${escapeHtml(headTip)}"` : ''}>${escapeHtml(keepNameWhole(badiLine))}${holyEntry?.workSuspended ? ' *' : ''}</span>
            </div>
            ${badges ? `<div class="cal-badges">${badges}</div>` : ''}
            ${events || others ? `<ul class="cal-entries">${events}${others}</ul>` : ''}
          </div>`);
        day = addDays(day, 1);
      }
      grid.innerHTML = parts.join('');
    }

    setUpHoverCard(root, grid);
    // Signing in or out changes what may be seen, so the configuration is
    // fetched again rather than filtered locally.
    setUpSignIn(root, () => {
      void loadServerConfig().then(() => {
        syncPublicToggles();
        void render();
      });
    });

    void loadServerConfig().then(() => void render());
  }

  /**
   * Signing in and out.
   *
   * The tier lives in a signed, HttpOnly cookie, so the page cannot read it and
   * cannot claim one it was not given. What tier the caller holds is asked of
   * the server rather than remembered locally — the answer is the server's to
   * give, and it is what every other request will be judged against.
   */
  function setUpSignIn(root: HTMLElement, onTierChange: () => void) {
    const panel = root.querySelector<HTMLElement>('[data-signin]')!;
    const scrim = root.querySelector<HTMLElement>('[data-signin-scrim]')!;
    const openBtn = root.querySelector<HTMLButtonElement>('[data-open-signin]')!;
    const tierLabel = root.querySelector<HTMLElement>('[data-tier-label]')!;
    const signInForm = root.querySelector<HTMLElement>('[data-signin-form]')!;
    const signOutForm = root.querySelector<HTMLElement>('[data-signout-form]')!;
    const codeInput = root.querySelector<HTMLInputElement>('[data-signin-code]')!;
    const error = root.querySelector<HTMLElement>('[data-signin-error]')!;

    function show(tier: string, label: string) {
      tierLabel.textContent = tier === 'public' ? 'the public' : label;
      const signedIn = tier !== 'public';
      signInForm.hidden = signedIn;
      signOutForm.hidden = !signedIn;
      openBtn.classList.toggle('is-signed-in', signedIn);
      openBtn.title = signedIn ? `Signed in — ${label}` : 'Sign in';
    }

    async function refresh() {
      try {
        const res = await fetch('/api/calendar-session.json');
        const body = (await res.json()) as { tier: string; label: string };
        show(body.tier, body.label);
      } catch {
        show('public', 'Public');
      }
    }

    function open() {
      panel.hidden = false;
      scrim.hidden = false;
      error.hidden = true;
      codeInput.value = '';
      void refresh();
      requestAnimationFrame(() => codeInput.focus());
    }
    function close() {
      panel.hidden = true;
      scrim.hidden = true;
    }

    openBtn.addEventListener('click', open);
    scrim.addEventListener('click', close);
    root.querySelector('[data-close-signin]')!.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) close();
    });

    async function submit() {
      error.hidden = true;
      try {
        const res = await fetch('/api/calendar-session.json', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ code: codeInput.value }),
        });
        const body = (await res.json()) as { ok?: boolean; error?: string; tier?: string; label?: string };
        if (!body.ok) {
          error.textContent = body.error ?? 'That code was not recognised.';
          error.hidden = false;
          return;
        }
        show(body.tier!, body.label!);
        codeInput.value = '';
        close();
        // What the calendar may show depends on the tier, so fetch it again.
        onTierChange();
      } catch {
        error.textContent = 'Could not reach the server just now.';
        error.hidden = false;
      }
    }

    root.querySelector('[data-signin-submit]')!.addEventListener('click', () => void submit());
    codeInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') void submit();
    });

    root.querySelector('[data-signout]')!.addEventListener('click', async () => {
      await fetch('/api/calendar-session.json', { method: 'DELETE' });
      show('public', 'Public');
      close();
      onTierChange();
    });

    void refresh();
  }

  /**
   * A hover card for calendar entries, replacing the browser's own tooltip.
   *
   * The native `title` tooltip waits about a second before appearing, renders
   * in a small dark box we cannot style, and never shows on keyboard focus.
   * This shows immediately, is legible, and is reachable by tab as well as by
   * pointer. One element is reused for every entry, and events are delegated
   * from the grid, so adding it costs nothing per cell.
   */
  function setUpHoverCard(root: HTMLElement, grid: HTMLElement) {
    const card = document.createElement('div');
    card.className = 'cal-card';
    card.setAttribute('role', 'tooltip');
    card.hidden = true;
    root.appendChild(card);

    let showTimer: number | undefined;
    let current: HTMLElement | null = null;

    function place(target: HTMLElement) {
      const t = target.getBoundingClientRect();
      const c = card.getBoundingClientRect();
      const margin = 8;
      // Prefer above the entry; drop below when there is no room up there.
      let top = t.top - c.height - margin;
      let below = false;
      if (top < margin) {
        top = t.bottom + margin;
        below = true;
      }
      let left = t.left + t.width / 2 - c.width / 2;
      left = Math.max(margin, Math.min(left, window.innerWidth - c.width - margin));
      // Fixed positioning, so these stay viewport coordinates. Positioning it
      // absolutely would place it relative to the calendar container rather
      // than the page, putting it hundreds of pixels off.
      card.style.top = `${top}px`;
      card.style.left = `${left}px`;
      card.classList.toggle('is-below', below);
    }

    function show(target: HTMLElement) {
      const text = target.dataset.tip;
      if (!text) return;
      current = target;
      card.innerHTML = text
        .split('\n')
        .filter(Boolean)
        .map((line) => {
          const at = line.indexOf('|');
          const kind = at === -1 ? 'note' : line.slice(0, at);
          const body = escapeHtml(at === -1 ? line : line.slice(at + 1));
          return kind === 'title'
            ? `<strong>${body}</strong>`
            : `<span class="tip-${kind}">${body}</span>`;
        })
        .join('');
      card.hidden = false;
      // Position, then reveal, in this same turn.
      //
      // An earlier version waited for requestAnimationFrame before adding the
      // visible class. rAF does not fire in a hidden or heavily throttled tab,
      // so the card would be built and positioned but stay at opacity 0 —
      // present in the DOM and invisible on screen. place() already forces a
      // layout by reading getBoundingClientRect, so the element has its
      // dimensions and the transition has a start state to animate from
      // without waiting for a frame that may never come.
      place(target);
      void card.offsetWidth;
      card.classList.add('is-visible');
    }

    function hide() {
      window.clearTimeout(showTimer);
      current = null;
      card.classList.remove('is-visible');
      card.hidden = true;
    }

    grid.addEventListener('mouseover', (e) => {
      const target = (e.target as HTMLElement).closest<HTMLElement>('[data-tip]');
      if (!target || target === current) return;
      window.clearTimeout(showTimer);
      // Just enough delay to avoid flickering while the pointer crosses cells.
      showTimer = window.setTimeout(() => show(target), 60);
    });
    grid.addEventListener('mouseout', (e) => {
      const target = (e.target as HTMLElement).closest<HTMLElement>('[data-tip]');
      if (!target) return;
      const to = (e as MouseEvent).relatedTarget as Node | null;
      if (to && target.contains(to)) return;
      hide();
    });
    grid.addEventListener('focusin', (e) => {
      const target = (e.target as HTMLElement).closest<HTMLElement>('[data-tip]');
      if (target) show(target);
    });
    grid.addEventListener('focusout', hide);
    // Touch: a tap focuses the entry, and anything else dismisses the card.
    document.addEventListener('scroll', hide, { passive: true });
    window.addEventListener('resize', hide);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') hide();
    });
  }

  // ---- helpers -------------------------------------------------------------

  /** "7:00 pm – 9:30 pm", or "All day" when there is no time to show. */
  function formatEventTime(ev: IcsEvent): string {
    if (ev.allDay || !ev.startTime) return 'All day';
    const clock = (hhmm: string) => {
      const [h, m] = hhmm.split(':').map(Number);
      const suffix = h >= 12 ? 'pm' : 'am';
      const hour = h % 12 === 0 ? 12 : h % 12;
      return m === 0 ? `${hour}${suffix}` : `${hour}:${String(m).padStart(2, '0')}${suffix}`;
    };
    return ev.endTime && ev.endTime !== ev.startTime
      ? `${clock(ev.startTime)} – ${clock(ev.endTime)}`
      : clock(ev.startTime);
  }

  const WEEKDAY_FULL = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

  /**
   * The text of an entry's hover card.
   *
   * Traditions whose day begins at sunset are marked plainly rather than
   * silently: a reader looking at Friday should know an observance dated
   * Saturday actually starts on Friday evening. Bahá'í observances say this
   * with shading on the preceding cell as well; for everything else, which is
   * rendered as plain text, the note carries it.
   */
  function buildTip(o: Occurrence & { name: string }, group: Entry['group']): string {
    const lines: string[] = [`title|${o.name}`];

    if (o.startsPreviousEvening) {
      const evening = WEEKDAY_FULL[weekday(addDays(o.date, -1))];
      lines.push(`eve|Starts ${evening} evening, at sunset.`);
    }

    lines.push(
      `when|${
        o.endDate && o.endDate !== o.date
          ? `${formatLongDate(o.date)} – ${formatLongDate(o.endDate)}`
          : formatLongDate(o.date)
      }`,
    );

    if (group === 'bahai') lines.push(`badi|${formatBadiDate(gregorianToBadi(o.date), true)}`);
    if (o.workSuspended) lines.push('work|Work is suspended.');
    if (o.note) lines.push(`note|${o.note}`);

    if (o.confidence === 'approximate') {
      lines.push('caveat|Calculated — this tradition sets its dates by observation or local custom, so the day may differ.');
    } else if (o.confidence === 'verified') {
      lines.push('caveat|Confirmed against an announced date.');
    }
    return lines.join('\n');
  }

  function badgeFor(o: Occurrence, kind: Entry['kind']): string | undefined {
    if (kind === 'holy-day') return o.workSuspended ? 'Holy Day *' : 'Holy Day';
    if (kind === 'feast') {
      // The Feast badge carries the month's English meaning — Splendour,
      // Glory, Beauty — which is more use to a reader than the word "Feast".
      const m = /\(([^)]+)\)\s*$/.exec(o.name);
      return m ? m[1] : 'Feast';
    }
    if (kind === 'month') {
      if (o.name.startsWith('Ayyám-i-Há')) return 'Ayyám-i-Há';
      if (o.name.startsWith('The Fast')) return undefined;
      // "Núr (Light)" -> "Light": the month's meaning is more use to a reader
      // than repeating its name, which is already on the date line.
      const m = /\(([^)]+)\)\s*$/.exec(o.name);
      return m ? m[1] : undefined;
    }
    return undefined;
  }

  function push(map: Map<string, Entry[]>, day: string, entry: Entry) {
    const list = map.get(day);
    if (list) list.push(entry);
    else map.set(day, [entry]);
  }

  function spanDays(start: string, end?: string): string[] {
    if (!end || end <= start) return [start];
    const out: string[] = [];
    let d = start;
    // Guard against a malformed feed producing an unbounded span.
    for (let i = 0; i < 400 && d <= end; i += 1) {
      out.push(d);
      d = addDays(d, 1);
    }
    return out;
  }

  function todayIso(): string {
    // Brisbane has no daylight saving, so a fixed +10 offset is exact.
    const now = new Date();
    const brisbane = new Date(now.getTime() + (now.getTimezoneOffset() + 600) * 60000);
    return isoDate({
      year: brisbane.getFullYear(),
      month: brisbane.getMonth() + 1,
      day: brisbane.getDate(),
    });
  }

  function startOfMonth(iso: string): string {
    const { year, month } = parseIso(iso);
    return isoDate({ year, month, day: 1 });
  }

  function shiftMonth(iso: string, delta: number): string {
    const { year, month } = parseIso(iso);
    const m = month - 1 + delta;
    return isoDate({ year: year + Math.floor(m / 12), month: ((m % 12) + 12) % 12 + 1, day: 1 });
  }

  function formatLongDate(iso: string): string {
    const { year, month, day } = parseIso(iso);
    return `${day} ${MONTH_NAMES[month - 1]} ${year}`;
  }

  /**
   * Stop a line break falling inside a name.
   *
   * Browsers break after a hyphen whatever `hyphens` says, which split
   * "Ascension of ‘Abdu'l-Bahá" across two lines mid-name. Swapping in a
   * non-breaking hyphen keeps the name whole and moves the break to a space,
   * where it belongs. Applies to Naw-Rúz, Ayyám-i-Há and the rest equally.
   */
  /**
   * Calendar feeds we will fetch. Mirrors the allowlist the proxy enforces on
   * the server — this copy only exists to give a useful message before the
   * request is made, and is not what actually protects the endpoint.
   */
  function isSupportedFeedUrl(url: string): boolean {
    return /^https:\/\/(calendar\.google\.com|outlook\.(office365|office|live)\.com)\//.test(url);
  }

  function keepNameWhole(s: string): string {
    return s.replace(/-/g, '\u2011');
  }

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!,
    );
  }

  function loadPrefs(): Prefs {
    try {
      const raw = localStorage.getItem(PREFS_KEY);
      const parsed = raw ? (JSON.parse(raw) as Partial<Prefs>) : null;
      return {
        enabled: parsed?.enabled ?? {},
        sectionsOpen: parsed?.sectionsOpen ?? {},
      };
    } catch {
      return { enabled: {}, sectionsOpen: {} };
    }
  }

  function savePrefs(prefs: Prefs) {
    try {
      localStorage.setItem(PREFS_KEY, JSON.stringify(prefs));
    } catch {
      /* private browsing — preferences simply will not persist */
    }
  }

  // Entry point last: init() reads the module constants above, which are not
  // hoisted the way function declarations are.
  const root = document.querySelector<HTMLElement>('.calendar');
  if (root) init(root);
</script>

<style is:global>
  /*
   * Global rather than scoped: the grid is built by script after hydration, so
   * the generated cells never carry Astro's scoping attribute.
   *
   * Provisional styling — see the note at the top of this file. Holy Days take
   * the site's gold and Feasts its teal; what matters is that the two are
   * distinguished by hue and that other traditions stay unstyled, not these
   * particular colours.
   */
  .calendar {
    --cal-holy-tint: var(--color-gold-100);
    --cal-holy-ink: var(--color-gold-700);
    --cal-feast-tint: var(--color-teal-100);
    --cal-feast-ink: var(--color-teal-700);
    --cal-line: color-mix(in srgb, var(--color-teal-900) 14%, transparent);
    position: relative;
  }

  /* The page title, in place of the hero the calendar used to sit beneath. */
