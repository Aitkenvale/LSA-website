    margin: 0.1rem 0 0;
    white-space: nowrap;
  }

  /* The grid scrolls inside its own box rather than the page. */
  .cal-grid-wrap { overflow-x: auto; }
  .cal-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(6.4rem, 1fr));
