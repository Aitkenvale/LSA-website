---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  intro: string;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { title, intro, image, imageAlt = '' } = Astro.props;
---

<section class="relative overflow-hidden bg-teal-900">
  {
    image && (
      <Image
        src={image}
        alt={imageAlt}
        widths={[640, 1024, 1600]}
        sizes="100vw"
        class="absolute inset-0 h-full w-full object-cover opacity-40"
        loading="eager"
      />
    )
  }
  <div class="absolute inset-0 bg-gradient-to-br from-teal-950/90 via-teal-900/70 to-teal-700/50" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="h-1 w-16 rounded bg-gold-500" aria-hidden="true"></div>
    <h1 class="font-display mt-6 max-w-3xl text-4xl font-semibold text-white sm:text-5xl">{title}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-teal-100">{intro}</p>
  </div>
</section>
