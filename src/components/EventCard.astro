---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { formatDay, formatMonthShort, formatFullDate, formatTimeRange } from '../lib/dates';

interface Props {
  event: CollectionEntry<'events'>;
}
const { event } = Astro.props;
const { title, start, end, location, image, imageAlt = '' } = event.data;
const { Content } = await render(event);
---

<article class="flex flex-col overflow-hidden rounded-2xl bg-white shadow-lg shadow-teal-900/5 ring-1 ring-teal-900/5">
  <div class="relative">
    {
      image ? (
        <Image
          src={image}
          alt={imageAlt}
          widths={[480, 800]}
          sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
          class="aspect-[16/9] w-full object-cover"
        />
      ) : (
        <div class="aspect-[16/9] w-full bg-gradient-to-br from-teal-700 to-teal-900" aria-hidden="true" />
      )
    }
    <div class="absolute top-4 left-4 flex flex-col items-center rounded-xl bg-sand-50 px-3 py-2 text-teal-900 shadow-md">
      <span class="font-display text-2xl leading-none font-bold">{formatDay(start)}</span>
      <span class="text-xs font-semibold tracking-wide uppercase">{formatMonthShort(start)}</span>
    </div>
  </div>
  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-display text-xl font-semibold text-teal-900">{title}</h3>
    <p class="mt-2 text-sm font-medium text-teal-700">
      {formatFullDate(start)} · {formatTimeRange(start, end)}
    </p>
    <p class="mt-1 flex items-center gap-1.5 text-sm text-ink/70">
      <svg class="h-4 w-4 shrink-0 text-gold-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"></path>
      </svg>
      {location}
    </p>
    <div class="prose-site mt-3 text-sm">
      <Content />
    </div>
  </div>
</article>
