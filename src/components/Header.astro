---
import Logo from './Logo.astro';
import { getSiteSettings } from '../lib/site';

const settings = await getSiteSettings();
const links = [
  { href: '/', label: 'Home' },
  { href: '/what-we-believe/', label: 'What We Believe' },
  { href: '/what-we-do/', label: 'What We Do' },
  { href: '/community-centre/', label: 'Community Centre' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-teal-900/10 bg-sand-50/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-3 text-teal-900">
      <Logo class="h-9 w-9" />
      <span class="font-display text-lg leading-tight font-semibold sm:text-xl">
        {settings.siteName}
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'rounded-full px-4 py-2 text-sm font-medium transition-colors',
              isActive(link.href)
                ? 'bg-teal-700 text-white'
                : 'text-teal-900 hover:bg-teal-100',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <button
      id="menu-toggle"
      type="button"
      class="rounded-lg p-2 text-teal-900 hover:bg-teal-100 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="sr-only">Open menu</span>
      <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-teal-900/10 px-4 pt-2 pb-4 md:hidden" aria-label="Main mobile">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[
            'block rounded-lg px-4 py-3 text-base font-medium',
            isActive(link.href) ? 'bg-teal-700 text-white' : 'text-teal-900 hover:bg-teal-100',
          ]}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
