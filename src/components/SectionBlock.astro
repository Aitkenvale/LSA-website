---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { marked } from 'marked';

interface Props {
  heading: string;
  text: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imageCaption?: string;
  imageStyle?: 'photo' | 'emblem';
  flip?: boolean;
}
const {
  heading,
  text,
  image,
  imageAlt = '',
  imageCaption,
  imageStyle = 'photo',
  flip = false,
} = Astro.props;
// breaks:true — a single Enter in the editor shows as a line break on the page
const html = marked.parse(text, { breaks: true });
---

<section
  class:list={[
    'mx-auto max-w-6xl px-4 sm:px-6 sm:py-14',
    // emblem: no bottom padding on mobile so text→icon and icon→next-section match
    image && imageStyle === 'emblem' ? 'pt-10 pb-0' : 'py-10',
  ]}
>
  <div
    class:list={[
      'grid items-center sm:gap-12',
      image && imageStyle === 'emblem' ? 'gap-10' : 'gap-8',
      image ? 'md:grid-cols-2' : 'md:max-w-3xl',
    ]}
  >
    <div class:list={[image && flip && 'md:order-2']}>
      <div class="h-1 w-10 rounded bg-gold-500" aria-hidden="true"></div>
      <h2 class="font-display mt-4 text-2xl font-semibold text-teal-900 sm:text-3xl">{heading}</h2>
      <div class="prose-site mt-4" set:html={html} />
    </div>
    {
      image && (
        <figure>
          {imageStyle === 'emblem' ? (
            <Image
              src={image}
              alt={imageAlt}
              widths={[120, 280]}
              sizes="(min-width: 768px) 12vw, 4rem"
              class="mx-auto w-16 object-contain md:w-1/4"
            />
          ) : (
            <Image
              src={image}
              alt={imageAlt}
              widths={[480, 800, 1200]}
              sizes="(min-width: 768px) 50vw, 100vw"
              class="aspect-[3/2] w-full rounded-2xl object-cover shadow-lg shadow-teal-900/10"
            />
          )}
          {imageCaption && (
            <figcaption class="mt-2 text-center text-xs text-ink/45">{imageCaption}</figcaption>
          )}
        </figure>
      )
    }
  </div>
</section>
